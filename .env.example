# Copy to .env.local and fill in as you create accounts (Phase 1–5).

# Neon Postgres (Prisma)
DATABASE_URL=



# Brevo (inquiry + document notification emails)
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Verified sender on your Brevo domain
BREVO_FROM_EMAIL=support@flyvisapoints.com
BREVO_FROM_NAME=Fly & Visa point
# Where new inquiries are delivered
AGENCY_INBOX_EMAIL=support@flyvisapoints.com

# Clerk (admin/staff)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob (passport / document uploads)
BLOB_READ_WRITE_TOKEN=



# Public site URL (sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://flyticketvisa.com
