generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String
  country   String?
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}
